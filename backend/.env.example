# FASO LOVE API — configuration (copier en .env et adapter)
# ⚠️ Ne JAMAIS committer le fichier .env réel (déjà exclu via .gitignore).

APP_NAME=FASO LOVE API
ENV=dev

# Base de données (PostgreSQL 16 via docker-compose)
DATABASE_URL=postgresql+asyncpg://fasolove:fasolove@localhost:5432/fasolove

# JWT — ⚠️ générer un secret fort en production (ex: openssl rand -hex 32)
JWT_SECRET=change-me-en-production-0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# OTP SMS
OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# true UNIQUEMENT en dev : renvoie le code OTP dans la réponse HTTP
OTP_DEV_ECHO=true

# Envoi SMS : "console" (dev, affiche en log) — l'intégration d'un
# agrégateur réel (Africa's Talking, Orange SMS API…) arrive en phase 1b.
SMS_PROVIDER=console

# Règle d'âge (produit strictement réservé aux adultes)
MIN_AGE=18
MAX_AGE=120

# CORS — restreindre aux domaines de l'app/admin en production (phase 6)
CORS_ORIGINS=*
