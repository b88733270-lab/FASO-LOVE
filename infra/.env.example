# ============================================================================
# FASO LOVE — production : modèle de variables (NE JAMAIS COMMITER .env réel)
# copier : cp infra/.env.example infra/.env   →   puis REMPLIR toutes les <…>
# ============================================================================

# --- Base de données ---
DB_PASSWORD=<mot-de-passe-pg-aleatoire-32+ (openssl rand -hex 24)>

# --- Sessions ---
JWT_SECRET=<openssl rand -hex 48>
CORS_ORIGINS=https://app.fasolove.bf,https://admin.fasolove.bf

# --- SMS (Africa's Talking BF ou équivalent) ---
SMS_PROVIDER=africastalking
AFRICASTALKING_USERNAME=<login>
AFRICASTALKING_API_KEY=<clé-live>

# --- Paiements Mobile Money (PayDunya compte business) ---
PAYMENTS_PROVIDER=paydunya
PAYDUNYA_MASTER_KEY=<master>
PAYDUNYA_PRIVATE_KEY=<private>
PAYDUNYA_PUBLIC_KEY=<public>
PAYDUNYA_MODE=live
PAYMENTS_WEBHOOK_PUBLIC_URL=https://api.fasolove.bf/api/v1/payments/webhook/paydunya

# --- Push (Firebase Cloud Messaging) ---
PUSH_PROVIDER=fcm
FCM_SERVER_KEY=<clé-serveur-legacy-fcm>

# --- Observabilité (optionnel mais recommandé) ---
SENTRY_DSN=<https://…@o….ingest.sentry.io/…>

# --- Réglages plateforme ---
UVICORN_WORKERS=2
BACKUP_KEEP=30
